{
    "name": "search/api",
    "description": "Search API for Manticore Search system",
    "type": "project",
    "require": {
        "php": "^8.5",
        "symfony/framework-bundle": "^6.0",
        "symfony/console": "^6.0",
        "symfony/http-foundation": "^6.0",
        "symfony/routing": "^6.0",
        "symfony/dependency-injection": "^6.0",
        "guzzlehttp/guzzle": "^7.4",
        "php-http/client-common": "^2.5",
        "slim/slim": "^4.10",
        "slim/psr7": "^1.5",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "symfony/var-dumper": "^6.0",
        "phpstan/phpstan": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "chmod -R 755 ."
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}